[Unit]
Description=Reagent Cabinet Server
After=network-online.target postgresql.service
Wants=network-online.target

[Service]
User=appsvc
Group=appsvc
WorkingDirectory=/opt/reagent-server
Environment=TZ=Asia/Shanghai
EnvironmentFile=/etc/reagent-server.env
ExecStart=/opt/reagent-server/start.sh
SuccessExitStatus=143
Restart=on-failure
RestartSec=5
LimitNOFILE=65535

[Install]
WantedBy=multi-user.target
