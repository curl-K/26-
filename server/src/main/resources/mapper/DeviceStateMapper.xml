<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="edu.whpu.reagent.persistence.mapper.DeviceStateMapper">

    <update id="updateSeq">
        UPDATE device_state SET last_seq = #{seq} WHERE id = 1
    </update>

    <update id="touchHeartbeat">
        UPDATE device_state SET last_heartbeat = #{at} WHERE id = 1
    </update>
</mapper>
